# Crossref uses this address for its polite API pool.
# Use a valid contact email only in your private .env file.
CROSSREF_MAILTO=researcher@example.edu

# Optional OpenAlex API key.
OPENALEX_API_KEY=

# Optional Semantic Scholar Academic Graph API key.
SEMANTIC_SCHOLAR_API_KEY=

# Maximum bibliography entries accepted in one request.
BIBTEX_MAX_ENTRIES=500

# Browser origins allowed to call the backend.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500